{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tiktok-video-splitter:segments",
  "title": "TikTok Video Splitter Segments",
  "type": "object",
  "required": [
    "schema_version",
    "skill_version",
    "package",
    "source",
    "detection",
    "quality",
    "resources",
    "model",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "skill_version": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["relative_path", "sha256", "duration_ms"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "start_ms",
          "end_ms",
          "duration_ms",
          "purpose",
          "content",
          "clip",
          "keyframe"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
