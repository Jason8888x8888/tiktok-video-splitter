{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tiktok-video-splitter:candidates",
  "title": "TikTok Video Splitter Candidate Shots",
  "type": "object",
  "required": ["schema_version", "source_sha256", "detection", "quality", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "detection": {
      "type": "object",
      "required": [
        "raw_event_count",
        "clustered_event_count",
        "kept_event_count",
        "events_truncated",
        "candidate_count"
      ],
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["status", "human_review_recommended"],
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_ms", "end_ms", "duration_ms"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
